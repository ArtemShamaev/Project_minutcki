static func get_tex(name: String, size: int = 32) -> Texture2D:
	var key := "%s_%d" % [name, size]
	if _cache.has(key):
		return _cache[key]
	var body: String = SVG.get(name, SVG["select"])
	var svg := '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32">%s</svg>' % body
	var img := Image.new()
	img.load_svg_from_string(svg, size / 32.0)
	img.generate_mipmaps()
	var tex := ImageTexture.create_from_image(img)
	_cache[key] = tex
	return tex
