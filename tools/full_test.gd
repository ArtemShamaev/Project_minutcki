extends SceneTree
func _init():
	var c = City.new()
	c.generate(12345)
	Demo.build(c, 120)
	c.toggle_policy("recycling", 0)
	for i in 120: c.tick_day()
	print("pop ", c.population, " lines ", c.lines.size(), " riders ", c.transit_riders, " share ", snappedf(c.transit_share, 0.01), " districts ", c.districts.size(), " money ", int(c.money))
	print("budget ", c.projected)
	var d = c.to_dict()
	var f = FileAccess.open("user://test_save.dat", FileAccess.WRITE)
	f.store_var(d); f.close()
	f = FileAccess.open("user://test_save.dat", FileAccess.READ)
	var d2 = f.get_var(); f.close()
	DirAccess.remove_absolute(ProjectSettings.globalize_path("user://test_save.dat"))
	var c2 = City.new()
	c2.from_dict(d2)
	print("loaded pop ", c2.population, " lines ", c2.lines.size(), " districts ", c2.districts.size(), " policies ", c2.city_policies, " bld ", c2.buildings.size(), " h_eq ", c2.height == c.height)
	for i in 30: c2.tick_day()
	print("after 30 days pop ", c2.population)
	quit()
